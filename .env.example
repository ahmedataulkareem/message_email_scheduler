# App
APP_URL=http://localhost:3000
CRON_SECRET=
UNSUB_SECRET=
# Comma-separated emails/phones. Set this in every non-production environment
# so a bug can't send to real voters. Leave unset only in production.
SEND_ALLOWLIST=you@example.com,+15555550100
# Single-tenant pilot: the tenants.id row this deployment serves.
DEFAULT_TENANT_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Amazon SES
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
